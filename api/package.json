{
  "name": "interview-1-api",
  "version": "1.0.0",
  "private": true,
  "engines": { "node": ">=24 <25" },
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "typecheck": "tsc --noEmit",
    "start": "node dist/main.js",
    "cli": "ts-node src/command.ts",
    "send-webhook:all": "ts-node src/command.ts send-webhook all",
    "send-webhook:list": "ts-node src/command.ts send-webhook list",
    "send-webhook:create": "ts-node src/command.ts send-webhook create",
    "send-webhook:existing-email": "ts-node src/command.ts send-webhook existing-email",
    "send-webhook:replay": "ts-node src/command.ts send-webhook replay",
    "send-webhook:duplicate": "ts-node src/command.ts send-webhook duplicate",
    "send-webhook:contact-conflict": "ts-node src/command.ts send-webhook contact-conflict",
    "send-webhook:update": "ts-node src/command.ts send-webhook update",
    "send-webhook:delete": "ts-node src/command.ts send-webhook delete",
    "send-webhook:deleted-account": "ts-node src/command.ts send-webhook deleted-account",
    "send-webhook:invalid": "ts-node src/command.ts send-webhook invalid"
  },
  "dependencies": {
    "@apollo/server": "5.5.1",
    "@as-integrations/express5": "1.1.2",
    "@nestjs/apollo": "13.2.0",
    "@nestjs/common": "11.2.7",
    "@nestjs/core": "11.2.7",
    "@nestjs/graphql": "13.2.0",
    "@nestjs/platform-express": "11.2.7",
    "graphql": "16.11.0",
    "nest-commander": "3.21.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.24",
    "@types/inquirer": "8.2.13",
    "@types/node": "24.19.1",
    "ts-node": "10.9.2",
    "typescript": "5.9.3"
  }
}
